INF = 999

# Adjacency Matrix
graph = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]

departments = ["Computer", "IT", "Mechanical", "Civil", "Library"]
V = len(graph)


# Kruskal's Algorithm
def kruskal():
    edges = []

    for i in range(V):
        for j in range(i + 1, V):
            if graph[i][j] != 0:
                edges.append((graph[i][j], i, j))

    edges.sort()
    parent = list(range(V))
    cost = 0

    def find(x):
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]

    print("\nKruskal's Algorithm")

    for weight, u, v in edges:
        a = find(u)
        b = find(v)

        if a != b:
            parent[a] = b
            print(departments[u], "-", departments[v], ":", weight)
            cost += weight

    print("Minimum Cost =", cost)


# Prim's Algorithm
def prim():
    visited = [False] * V
    visited[0] = True
    cost = 0

    print("\nPrim's Algorithm")

    for _ in range(V - 1):
        minimum = INF
        x = y = -1

        for i in range(V):
            if visited[i]:
                for j in range(V):
                    if not visited[j] and graph[i][j] != 0:
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            x, y = i, j

        if y == -1:
            print("Graph is disconnected")
            return

        print(departments[x], "-", departments[y], ":", minimum)
        visited[y] = True
        cost += minimum

    print("Minimum Cost =", cost)


kruskal()
prim()
